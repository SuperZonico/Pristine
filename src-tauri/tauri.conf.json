{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pristine",
  "version": "1.0.0",
  "identifier": "com.superzonico.pristine",
  "build": {
    "beforeDevCommand": "node server.js",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pristine",
        "width": 1120,
        "height": 750,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
